*
# Ignore everything unless it is explicitly part of the repository below.

# Root project files.
!/.envrc
!/.gitignore
!/LICENSE
!/Makefile
!/README.md
!/flake.lock
!/flake.nix

# CI configuration.
!/.github/
!/.github/**

# Frontend applications.
!/apps/
!/apps/gui-slint/
!/apps/gui-slint/Cargo.lock
!/apps/gui-slint/Cargo.toml
!/apps/gui-slint/build.rs
!/apps/gui-slint/src/
!/apps/gui-slint/src/**
!/apps/gui-slint/ui/
!/apps/gui-slint/ui/**
!/apps/gui-swift/
!/apps/gui-swift/Package.swift
!/apps/gui-swift/README.md
!/apps/gui-swift/CMeikiPopFFI/
!/apps/gui-swift/CMeikiPopFFI/**
!/apps/gui-swift/Sources/
!/apps/gui-swift/Sources/**

# Rust libraries.
!/crates/
!/crates/native/
!/crates/native/Cargo.lock
!/crates/native/Cargo.toml
!/crates/native/README.md
!/crates/native/src/
!/crates/native/src/**
!/crates/native-ffi/
!/crates/native-ffi/Cargo.lock
!/crates/native-ffi/Cargo.toml
!/crates/native-ffi/src/
!/crates/native-ffi/src/**

# Shared application resources and development scripts.
!/resources/
!/resources/**
!/scripts/
!/scripts/**

# Generated and machine-local content inside allowed directories.
**/target/
**/.build/
**/__pycache__/
*.py[cod]
.DS_Store
.direnv/
.env
.venv/
env/
venv/
build/
dist/
data/
config.ini
dictionary.pkl
src/meikipop.egg-info/
bundle-repo/
*.flatpak
python3-deps.json
